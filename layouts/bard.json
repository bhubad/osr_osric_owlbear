5,14,2,29,48,3,"O26","1. Use poetic ability (PHB 118) for 2 rounds consecutively to raise morale by 10%, give a +1 to hit. Lasts for 1 turn."],[26,0,1,2,46,2,"A27"],[26,2,1,12,47,2,"C27"],[27,0,1,2,46,2,"A28"],[27,2,1,12,47,2,"C28"],[27,14,3,29,48,3,"O28","2. A bard’s singing and playing (PHB 118) negates the song effects of harpies and prevents similar attacks which rely upon song. and it will silence the noise of shriekers"],[28,0,1,2,46,2,"A29"],[28,2,1,12,47,2,"C29"],[29,0,1,2,46,2,"A30"],[29,2,1,12,47,2,"C30"],[30,0,1,2,46,2,"A31"],[30,2,1,12,47,2,"C31"],[30,14,2,29,49,3,"O31","3. Can charm by singing or playing (PHB 118)"],[31,0,1,2,46,2,"A32"],[31,2,1,12,47,2,"C32"],[32,0,1,2,46,2,"A33"],[32,2,1,12,47,2,"C33"],[32,14,1,29,45,1,0,"Restrictions"],[33,0,1,2,46,2,"A34"],[33,2,1,12,47,2,"C34"],[33,14,3,29,48,3,"O34","1. College (PHB 118): will not associate with Bards of lesser College, unless Magna Alumnae."],[34,0,1,2,46,2,"A35"],[34,2,1,12,47,2,"C35"],[35,0,1,2,46,2,"A36"],[35,2,1,12,47,2,"C36"],[36,0,1,2,46,2,"A37"],[36,2,1,12,47,2,"C37"],[36,14,4,24,50,3,"O37","2. Limited to employ henchmen that are druids, fighters or thieves of human, half-elven, or elven race. Can hire 1 henchmen when the Bard gets to 5th level, 2 at 8th, 3 at 11th, 4 at 14th, 5 at 17th, 6 at 20th and any number at 23rd. Limited by Charisma rating."],[36,38,2,5,51,1,0,"Max # Henchmen"],[37,0,1,2,46,2,"A38"],[37,2,1,12,47,2,"C38"],[38,0,1,2,46,2,"A39"],[38,2,1,12,47,2,"C39"],[38,38,2,5,52,3,"AM39"],[39,0,1,2,53,2,"A40"],[39,2,1,12,12,2,"C40"]]}